# Copiez ce fichier en `.env` (ignoré par git) puis adaptez les valeurs.
# Les valeurs ci-dessous sont les valeurs par défaut.

# Port publié sur l'hôte (le conteneur écoute toujours sur 8899).
RECLIP_PORT=8899
# Adresse d'écoute dans le conteneur.
RECLIP_HOST=0.0.0.0
# Binaire yt-dlp à utiliser.
RECLIP_YTDLP_BIN=yt-dlp
# Runtime JavaScript pour yt-dlp (vide = détection automatique, Deno est inclus).
RECLIP_JS_RUNTIME=
# Durée maximale d'un job, en secondes.
RECLIP_JOB_TIMEOUT=1800
# Nombre maximal de vidéos prises dans une playlist.
RECLIP_PLAYLIST_LIMIT=50
# Taille maximale d'un fichier téléchargé (ex. 500M, 2G).
RECLIP_MAX_FILESIZE=2G
# Durée maximale d'une vidéo, en secondes (10800 = 3 h).
RECLIP_MAX_DURATION=10800
# Chemin du fichier cookies.txt dans le conteneur (ex. /run/secrets/cookies.txt,
# à monter via compose.yaml). Vide = aucun cookie.
RECLIP_COOKIES=
# Proxy pour yt-dlp (ex. socks5://user:pass@host:1080). Vide = aucun.
RECLIP_PROXY=
# Nom du bot Telegram, sans le @ (phase ultérieure). Vide = désactivé.
RECLIP_TELEGRAM_BOT_USERNAME=
# Nombre de téléchargements simultanés, tous sites confondus (minimum 1).
RECLIP_MAX_CONCURRENT=4
# Nombre de téléchargements simultanés par site, ex. YouTube (minimum 1).
RECLIP_MAX_PER_SITE=2
# Durée de conservation d'un fichier terminé, en secondes (86400 = 24 h).
# Passé ce délai, le fichier est supprimé. La tâche expirée est retirée de la base 7 jours plus tard.
RECLIP_FILE_TTL=86400
# Période de nettoyage des fichiers expirés, en secondes (600 = 10 min).
RECLIP_CLEANUP_INTERVAL=600
# RECLIP_DATA_DIR et RECLIP_WEB_DIR sont réglés dans compose.yaml (dossiers du
# conteneur) : ne pas les modifier ici. RECLIP_DOWNLOADS_DIR n'est pas réglé :
# il découle de RECLIP_DATA_DIR (<RECLIP_DATA_DIR>/downloads, soit /data/downloads).
# RECLIP_DATA_DIR=/data
# RECLIP_WEB_DIR=/app/web
# Mettre à 1 pour ne pas mettre à jour yt-dlp au démarrage du conteneur.
RECLIP_NO_UPDATE=
# Niveau de logs (error, warn, info, debug, trace).
RUST_LOG=info
# Fuseau horaire du conteneur.
TZ=UTC
